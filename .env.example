############################################################
# Taximeter — self-hosted docker-compose configuration
# Generated by: ./taximeter install
# Do NOT edit manually unless you know what you're doing.
# One install = one taxi company.
############################################################

# --- Postgres ---
POSTGRES_PASSWORD=change-me-strong-password

# --- JWT (shared between Kong, GoTrue, PostgREST) ---
# Must be at least 32 characters
JWT_SECRET=change-me-at-least-32-chars-random-string
JWT_EXPIRY=3600

# --- Supabase service keys (generated by ./taximeter install) ---
ANON_KEY=
SERVICE_ROLE_KEY=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
INTERNAL_SECRET=change-me-random-string

# --- Supabase internal URLs (used by Next.js container) ---
NEXT_PUBLIC_SUPABASE_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_ANON_KEY=${ANON_KEY}
SUPABASE_SERVICE_ROLE_KEY=${SERVICE_ROLE_KEY}

# --- Site URL used by GoTrue for redirect callbacks ---
SITE_URL=http://localhost:3000
ADDITIONAL_REDIRECT_URLS=

# --- Company info (written by ./taximeter install, read by ./taximeter seed) ---
COMPANY_NAME=
COMPANY_TIMEZONE=America/Guayaquil
COMPANY_CONTACT=

# --- Fleet / dispatch settings ---
# Radius (meters) used for "taxis near you" availability counts
AVAILABILITY_RADIUS_M=3000
# Seconds a ride request stays offerable before it expires
REQUEST_TIMEOUT_S=60

# --- Fares ---
# Bill waiting time when the taxi is slow/stopped (speed-threshold model)
WAIT_TIME_BILLING=off
# Below this speed (km/h) time is billed; above it, distance is billed
WAIT_SPEED_THRESHOLD=10

# --- Payments ---
# Whose payment QR the passenger pays: per_driver | company
PAYMENT_QR_SCOPE=per_driver
# Run OCR duplicate/fraud check on shared payment proofs: on | off
PAYMENT_FRAUD_CHECK=off
# Company-wide payment QR (only used when PAYMENT_QR_SCOPE=company)
COMPANY_PAYMENT_QR_URL=
COMPANY_PAYMENT_ACCOUNT_LABEL=

# --- Passenger accounts ---
# Force all passengers to have a verified account: on | off
REQUIRE_PASSENGER_ACCOUNTS=off

# --- SMTP (only needed when passenger accounts are enabled) ---
# GoTrue autoconfirms emails when SMTP is not set (dev / anonymous-only installs).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=Taximeter
SMTP_ADMIN_EMAIL=

# --- Admin login (used by ./taximeter install) ---
ADMIN_EMAIL=
